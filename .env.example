# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# Токен бота от @BotFather (например: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
BOT_TOKEN=1234567890:AAExampleTokenFromBotFatherxxxxxxxxxx

# Числовой ID Telegram-канала магазина (для приватных каналов начинается с -100...)
CHANNEL_ID=-1001234567890

# Telegram ID администратора (обязательно!)
# Личный числовой ID администратора для получения уведомлений о ненайденных товарах и доступа к командам
# Узнать свой ID можно через бота @userinfobot или команду /myid в ЛС с ботом
ADMIN_ID=123456789

# Альтернативно: отдельный чат (группа) для заявок и список ID администраторов через запятую
# Если задан ADMIN_ID, эти переменные настраиваются автоматически
# ADMIN_CHAT_ID=-1009876543210
# ADMIN_IDS=123456789,987654321

# Режим работы бота: webhook (для Railway) или polling (для локальной разработки)
BOT_MODE=webhook

# Публичный URL сервиса (на Railway можно оставить пустым, подтянется из RAILWAY_PUBLIC_DOMAIN)
APP_BASE_URL=https://your-app-name.up.railway.app

# Секретный токен для проверки заголовка X-Telegram-Bot-Api-Secret-Token (1-256 символов [a-zA-Z0-9_-])
WEBHOOK_SECRET=my_secure_random_token_1234567890_secret

# Принудительно снять вебхук при локальном запуске polling (false по умолчанию)
POLLING_DELETE_WEBHOOK=false

# ==============================================================================
# Database Configuration
# ==============================================================================
# URL базы данных PostgreSQL (на Railway автоматически подставляется переменной ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres:password@localhost:5432/shopbot

# Размер пула соединений SQLAlchemy
DB_POOL_SIZE=5

# ==============================================================================
# Image Search & Embeddings
# ==============================================================================
# Провайдер эмбеддингов изображений: voyage (рекомендуется) или none (только pHash)
IMAGE_EMBEDDING_PROVIDER=voyage

# API ключ Voyage AI (получить на https://dash.voyageai.com/)
IMAGE_EMBEDDING_API_KEY=pa-voyage-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Мультимодальная модель Voyage, принимающая изображения
IMAGE_EMBEDDING_MODEL=voyage-multimodal-3.5

# Базовый URL API Voyage
IMAGE_EMBEDDING_BASE_URL=https://api.voyageai.com/v1

# Таймаут запроса к Voyage в секундах
IMAGE_EMBEDDING_TIMEOUT=30.0

# Максимальный размер стороны изображения перед отправкой в API (пиксели, для экономии токенов)
IMAGE_EMBEDDING_MAX_SIDE=1024

# Порог косинусной близости для уверенного совпадения (0.0 .. 1.0)
MATCH_THRESHOLD=0.86

# Минимальный отрыв лучшего совпадения от второго кандидата (защита от ложных похожих товаров)
MATCH_MARGIN=0.03

# Минимальный порог похожести для передачи как "неуверенное совпадение"
MATCH_MIN_SCORE=0.70

# Максимальное расстояние Хэмминга для этапа 1 (pHash точных копий, 0..64)
PHASH_MAX_DISTANCE=6

# Максимальный размер загружаемого изображения в мегабайтах (макс. 20 для Telegram)
MAX_IMAGE_SIZE_MB=10.0

# ==============================================================================
# Worker & System Configuration
# ==============================================================================
# Количество параллельных задач в воркере
WORKER_CONCURRENCY=4

# Время блокировки задачи воркером (в секундах)
JOB_LEASE_SECONDS=120

# Таймаут graceful shutdown (в секундах)
SHUTDOWN_GRACE_SECONDS=20

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Порт HTTP сервера (Railway подставляет автоматически)
PORT=8000

# Часовой пояс для заявок
TIMEZONE=Asia/Tashkent

# Парсер подписей (default)
CAPTION_PARSER=default

# Уведомлять администратора сводкой при добавлении/обновлении товара в каталоге
NOTIFY_ADMIN_ON_PRODUCT=true
